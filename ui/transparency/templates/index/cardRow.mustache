<tr class="search_results_button">
    <td>
        <a style="display:block;width:100%;height:100%;text-decoration:none;text-align:left" href="model_card.html?id={{id}}">
            <div class="row">
                <div>
                    <svg class="quality-circle" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="18"
                            fill="none" stroke="#434343" stroke-width="3"/>

                    <circle cx="18" cy="18" r="18"
                            fill="none"
                            stroke="{{qualityColor}}"
                            stroke-width="3"
                            stroke-dasharray="100"
                            stroke-dashoffset="{{dashOffset}}"/>

                    <text x="18" y="14" class="quality-text">{{percent}}%</text>
                    <text x="18" y="24" class="quality-text">info</text>
                    </svg>
                </div>

                <div>
                    <span style="display:block;color:#EEE">{{{name}}}</span>

                    {{#isDraft}}
                    <span style="font-size:13px;color:#F9AB49">
                    DRAFT (no version)
                    </span>
                    {{/isDraft}}

                    <span style="font-size:13px;color:#79CFDC">
                    {{creatorText}}
                    </span>

                    {{#hasType}}
                    <span style="font-size:13px;color:#79CFDC">
                    --- {{type}}{{task}}
                    </span>
                    {{/hasType}}
                </div>
            </div>

            <div style="font-size:13px;color:#C8C8C8;margin-top:7px;text-align:left">
                {{description}}
            </div>
        </a>    
    </td>
</tr>